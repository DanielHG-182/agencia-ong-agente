# Required
OPENAI_API_KEY=

# OpenAI models
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Multi-project structure
PROJECTS_BASE_DIR=projects
DIR_RAW=data/raw
DIR_PROCESSED=data/processed
DIR_CHUNKS=data/chunks
DIR_VECTOR_DB=vector_db
DIR_CONFIG=config
DIR_OUTPUT=output
DIR_DATASET_EVAL=data/evaluation

# Project files
FILE_DIRECTIVES=config/directives.md
FILE_TEMPLATE=config/template.docx
FILE_PROGRESS=progress.json
FILE_INDEX=config/index.json

# Chunking
CHUNK_MAX_TOKENS=1024
CHUNK_OVERLAP_TOKENS=150

# Retrieval
RETRIEVER_TOP_K=3

# Generation
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0

# Indexing
REINDEX=false

# Word document styles
STYLE_HEADING_1=Heading 1
STYLE_HEADING_2=Heading 2
STYLE_HEADING_3=Heading 3
STYLE_HEADING_4=Heading 4
STYLE_HEADING_5=Heading 5
STYLE_NORMAL=Normal
